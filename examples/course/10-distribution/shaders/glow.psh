#version 320 es
precision highp float;
uniform sampler2D u_source;
in vec2 v_uv;
layout(location = 0) out vec4 o_color;
void main() {
    vec2 pixel = 1.0 / vec2(textureSize(u_source, 0));
    vec3 center = texture(u_source, v_uv).rgb;
    vec3 blur = center * 0.4;
    blur += texture(u_source, v_uv + vec2(pixel.x * 2.0, 0.0)).rgb * 0.15;
    blur += texture(u_source, v_uv - vec2(pixel.x * 2.0, 0.0)).rgb * 0.15;
    blur += texture(u_source, v_uv + vec2(0.0, pixel.y * 2.0)).rgb * 0.15;
    blur += texture(u_source, v_uv - vec2(0.0, pixel.y * 2.0)).rgb * 0.15;
    o_color = vec4(clamp(center + max(blur - 0.55, 0.0) * 0.16, 0.0, 1.0), 1.0);
}
