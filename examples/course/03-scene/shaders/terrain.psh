#version 320 es
// <Sampler Name='u_samplerState' Texture='u_texture' />
precision highp float;
precision highp int;
uniform sampler2D u_texture;
in vec2 v_texcoord;
in vec4 v_color;
layout(location = 0) out vec4 o_sceneColor;
void main() {
    vec4 albedo = texture(u_texture, v_texcoord) * v_color;
    o_sceneColor = vec4(albedo.rgb * vec3(0.92, 1.0, 0.92), albedo.a);
}
