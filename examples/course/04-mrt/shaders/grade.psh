#version 320 es
precision highp float;
precision highp int;
uniform sampler2D u_sceneColor;
uniform sampler2D u_sceneNormal;
uniform sampler2D u_sceneMaterial;
in vec2 v_uv;
layout(location = 0) out vec4 o_color;
void main() {
    const int DEBUG_VIEW = 1; // 0: color, 1: encoded normal, 2: identifier bytes
    vec3 color = texture(u_sceneColor, v_uv).rgb;
    ivec2 size = textureSize(u_sceneNormal, 0);
    ivec2 pixel = clamp(ivec2(v_uv * vec2(size)), ivec2(0), size - 1);
    vec4 normalData = texelFetch(u_sceneNormal, pixel, 0);
    vec4 materialData = texelFetch(u_sceneMaterial, pixel, 0);
    if (DEBUG_VIEW == 1) {
        // Host encoded-normal bytes (oct RG plus a sign byte), not XYZ.
        // Display the encoding directly; decoding is outside this chapter.
        color = normalData.a > 0.5 ? normalData.rgb : vec3(0.12);
    } else if (DEBUG_VIEW == 2) {
        uint identifier = uint(round(materialData.r * 255.0)) | (uint(round(materialData.g * 255.0)) << 8u);
        color = materialData.a > 0.5 ? vec3(float(identifier & 15u) / 15.0, materialData.b, float((identifier >> 4u) & 15u) / 15.0) : vec3(0.12);
    }
    o_color = vec4(color, 1.0);
}
