#version 320 es
precision highp float;
uniform sampler2D u_sceneColor;
uniform float u_gain;
uniform float u_day;
uniform float u_rain;
in vec2 v_uv;
layout(location = 0) out vec4 o_color;
void main() {
    vec3 source = texture(u_sceneColor, v_uv).rgb;
    vec3 amber = (source - 0.5) * 1.06 + 0.5;
    amber *= vec3(1.06, 1.0, 0.93);
    float daylight = 0.5 + 0.5 * sin(6.2831853 * (u_day - 0.25));
    amber *= mix(vec3(0.91, 0.96, 1.04), vec3(1.03, 1.01, 0.97), daylight);
    amber = mix(amber, amber * vec3(0.91, 0.95, 1.0), u_rain * 0.45) * u_gain;
    o_color = vec4(clamp(mix(source, amber, float(GRADE_STRENGTH)), 0.0, 1.0), 1.0);
}
