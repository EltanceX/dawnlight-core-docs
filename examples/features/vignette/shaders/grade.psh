#version 320 es
precision highp float;
uniform sampler2D u_sceneColor;
in vec2 v_uv;
layout(location = 0) out vec4 o_color;
void main() {
    vec3 c = texture(u_sceneColor, v_uv).rgb;
    vec2 extent = vec2(textureSize(u_sceneColor, 0));
    vec2 p = (v_uv - 0.5) * vec2(extent.x / extent.y, 1.0);
    float mask = smoothstep(0.22, 0.82, length(p));
    o_color = vec4(c * (1.0 - 0.65 * float(GRADE_STRENGTH) * mask), 1.0);
}
