#version 320 es
precision highp float;
uniform sampler2D u_sceneColor;
in vec2 v_uv;
layout(location = 0) out vec4 o_color;
void main() {
    vec2 pixel = 1.0 / vec2(textureSize(u_sceneColor, 0));
    vec3 c = texture(u_sceneColor, v_uv).rgb;
    const vec3 weights = vec3(0.2126, 0.7152, 0.0722);
    float center = dot(c, weights);
    float edge = 0.0;
    edge = max(edge, abs(center - dot(texture(u_sceneColor, v_uv + vec2(pixel.x, 0.0)).rgb, weights)));
    edge = max(edge, abs(center - dot(texture(u_sceneColor, v_uv - vec2(pixel.x, 0.0)).rgb, weights)));
    edge = max(edge, abs(center - dot(texture(u_sceneColor, v_uv + vec2(0.0, pixel.y)).rgb, weights)));
    edge = max(edge, abs(center - dot(texture(u_sceneColor, v_uv - vec2(0.0, pixel.y)).rgb, weights)));
    float ink = smoothstep(0.08, 0.20, edge) * 0.85 * float(GRADE_STRENGTH);
    o_color = vec4(mix(c, vec3(0.02), ink), 1.0);
}
