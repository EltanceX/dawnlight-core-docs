{
  "name": "dawnlight-core-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.0"
  },
  "scripts": {
    "docs:dev": "npm run docs:generate && vitepress dev site --host 127.0.0.1",
    "docs:generate": "node scripts/generate-content.mjs",
    "docs:check": "node scripts/generate-content.mjs --check && node scripts/validate-content.mjs && node scripts/check-site.mjs",
    "docs:build": "npm run docs:generate && npm run docs:check && vitepress build site && node scripts/check-site-build.mjs",
    "docs:preview": "vitepress preview site --host 127.0.0.1",
    "test:site": "playwright test",
    "test:content": "node --test scripts/tests/content-foundation.test.mjs scripts/tests/reference-foundation.test.mjs",
    "reference:check": "node scripts/validate-reference-upstream.mjs",
    "reference:verify": "node scripts/validate-reference-upstream.mjs --verify-receipt",
    "examples:check": "node scripts/validate-examples.mjs",
    "examples:package": "node scripts/validate-examples.mjs --verify-receipt && npm run docs:generate",
    "authoring:check": "node scripts/validate-upstream.mjs --output artifacts/w3/upstream && npm run examples:check -- --verify-receipt",
    "upstream:verify": "node scripts/verify-upstream.mjs",
    "upstream:restore": "node scripts/restore-upstream.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vitepress": "1.6.4",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "vite": "6.4.5",
    "esbuild": "0.25.12"
  }
}
